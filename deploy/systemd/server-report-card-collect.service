[Unit]
Description=server-report-card: run every check and save today's results
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/server-report-card collect --quiet
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectHome=read-only
NoNewPrivileges=true
TimeoutStartSec=30min
